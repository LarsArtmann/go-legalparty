direction: down

fleet: Consumers (fleet) {
  model: "cqrs-htmx/legalparty-model (aliases.go bridge)"
  invoices: "invoices (tax_id_validation.go)"
  cmd: "company-master-data (REGON moves here)"
}

lib: "github.com/larsartmann/go-legalparty (single module, single package - shape unchanged)" {
  identifiers: "identifiers.go - VATID, LEI, RegisterRef"
  taxnumber: "taxnumber.go - TaxNumber"
  nip: "nip.go - NIP"
  regon: "REGON (9/14-digit weighted mod 11)" {
    style.stroke-dash: 4
  }
  country: "country.go - CountryCode + ISO 3166-1 table"
  legalform: "legalform.go - LegalFormClass + rule methods"
  kernel: "checksum + normalization kernels"
  vectors: "pinned vectors for every rejection path" {
    style.stroke-dash: 4
  }
}

ci: "CI gate (buildflow as push/PR check)" {
  style.stroke-dash: 4
}

ef: "go-error-family (rejection codes legalparty.<subject>.<cause>)"

fleet.model -> lib: aliases bridge
fleet.invoices -> lib: delegates checksums
fleet.cmd -> lib: parses + REGON

identifiers -> country: prefix parse
identifiers -> kernel
nip -> kernel
regon -> kernel
country -> kernel: normalize on parse
lib -> ef: NewRejection
lib -> ci: every push verified
